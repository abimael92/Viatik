# Dependencies
node_modules/
.pnp.*

# Next.js build output
.next/
out/
build/

# TypeScript caches
*.tsbuildinfo
# Auto-generated by Next.js; churns between dev/build and is regenerated on
# every `next dev` / `next build`, so it is not tracked.
next-env.d.ts

# Build/tool caches
.turbo/
.cache/
.vite/
.next/cache/

# Test and coverage output
playwright-report/
test-results/
coverage/
blob-report/
# Playwright MCP live-session snapshots (may capture real logged-in names)
.playwright-mcp/

# Environment variables and local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
# The encrypted environment file is safe to share — it holds no plaintext
# secrets and is intentionally committed so teammates can unlock it locally.
!.env.encrypted

# Supabase local state
supabase/.temp/
supabase/.branches/

# OS and editor files
.DS_Store
.vscode/
.idea/
*.log

# Capacitor native build artifacts
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/.idea/
ios/App/Pods/
ios/App/DerivedData/
ios/App/*.xcworkspace/xcuserdata/
ios/App/*.xcodeproj/xcuserdata/

# Local git worktrees checked out beside the main tree
.worktrees/

# Local tooling and deployment output
.vercel/
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
