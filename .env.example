# Supabase project credentials (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# WebAuthn / Passkeys
NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost
NEXT_PUBLIC_WEBAUTHN_RP_NAME=Viatik
NEXT_PUBLIC_WEBAUTHN_ORIGIN=http://localhost:3000

# SMS OTP provider (Supabase Phone Auth / Twilio, configured in Supabase dashboard)
# No app-level secret required here; kept for future direct-provider integration.
SMS_PROVIDER_API_KEY=

# Session signing secret (used for passkey session cookies). Must be >= 32 bytes.
AUTH_SESSION_SECRET=

# Signs short-lived QR connection tokens (the "magic" in-person auto-accept).
# Must be >= 32 bytes. Generate with: openssl rand -base64 48
QR_SIGNING_SECRET=

# Server-side Google Places API key for destination autocomplete.
GOOGLE_MAPS_API_KEY=

# Optional AI Activity Scout LLM endpoint + key. When unset, the scout uses the
# deterministic offline heuristic engine. The endpoint should accept a JSON POST
# body of { prompt, context } and return { suggestions: [...] }.
AI_SCOUT_ENDPOINT=
AI_SCOUT_API_KEY=

