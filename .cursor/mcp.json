{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.84", "--headless", "--isolated"]
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@cyanheads/git-mcp-server@2.15.3"]
    },
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@astudioplus/codegraph-mcp@0.21.0",
        "--workspace",
        ".",
        "--profile",
        "graph",
        "--graph-only"
      ]
    }
  }
}
